{
    "Pipeline": {
        "ArtifactsDirectory": "artifacts",
        "TempDirectory": "temp"
    },
    "DotNet": {
        "Configuration": "Release"
    },
    "Changelog": {
        "File": "CHANGELOG.md",
        "RepositoryUrl": "https://github.com/tom-wolfe/Wolfe.Hamelin"
    },
    "NuGet": {
        "Feed": "https://api.nuget.org/v3/index.json"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Debug"
        },
        "Console": {
            "FormatterOptions": {
                "TimestampFormat": "HH:mm:ss",
                "ColorBehavior": "Default"
            }
        }
    }
}
