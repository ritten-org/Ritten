<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Ritten.OpenTelemetry</Title>
    <Description>OpenTelemetry for Ritten workflows.</Description>
    <PackageTags>devops;cicd;build;automation;workflows;pipelines;opentelemetry;tracing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ritten.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ritten.Core\Ritten.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
