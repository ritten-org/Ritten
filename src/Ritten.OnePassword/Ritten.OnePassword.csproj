<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Ritten.OnePassword</Title>
    <Description>1Password for Ritten workflows: secrets read by op:// reference through the CLI, at the moment a step needs them.</Description>
    <PackageTags>devops;cicd;build;automation;workflows;pipelines;secrets;1password</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ritten.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ritten.Core\Ritten.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
